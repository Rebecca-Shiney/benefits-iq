FROM python:3.11-slim-bookworm@sha256:94a8fee35252d06ab75856f15f12c7bae67b10e8a6da93c7fded82b2610926cd
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 BENEFITS_PROFILE=showcase OTEL_SDK_DISABLED=true
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl libgssapi-krb5-2 \
    && curl --fail --silent --show-error --location https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb --output /tmp/microsoft-prod.deb \
    && dpkg -i /tmp/microsoft-prod.deb \
    && apt-get update && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
    && rm -f /tmp/microsoft-prod.deb && rm -rf /var/lib/apt/lists
COPY requirements.lock.txt ./
RUN pip install --no-cache-dir --requirement requirements.lock.txt && pip check \
    && useradd --system --uid 10001 --create-home benefits
COPY --chown=benefits:benefits service ./service
COPY --chown=benefits:benefits agents ./agents
COPY --chown=benefits:benefits infra/schema.sql infra/grant-runtime.sql ./infra/
USER benefits
EXPOSE 8000
CMD ["python", "-m", "service.cloud_entrypoint"]
