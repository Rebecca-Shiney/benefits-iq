# Local synthetic workflow; no model credentials required.
BENEFITS_SERVICE_URL=http://127.0.0.1:8000
BENEFITS_APP_ORIGIN=http://127.0.0.1:3000
# Set the same randomly generated secret in both processes (at least 32 characters).
BENEFITS_SERVICE_SECRET=
BENEFITS_DB=data/benefits.db
BENEFITS_MODE=synthetic
# Optional genuine model integration; never set NEXT_PUBLIC_ credentials.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional server-enforced feature gates; defaults are 1.
BENEFITS_ENABLE_CHAT=1
BENEFITS_ENABLE_INTAKE=1
BENEFITS_ENABLE_EVIDENCE=1
BENEFITS_ENABLE_RENEWAL=1
BENEFITS_ENABLE_EMPLOYER=1
BENEFITS_ENABLE_ACTIVITIES=1
